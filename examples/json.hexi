if (catch JSON_HEXI)
define JSON_HEXI true

fun assert cond msg
    if ! cond; throw "AssertError: " + msg; endif
endfun

fun json_internal_create_string input
    let output arr 3
    let output[0] input
    let output[1] 0
    let output[2] len input
    return output
endfun

fun json_internal_clone_string js start end
    let output    arr 3
    let output[0] js[0]
    let output[1] start
    let output[2] end
    return output
endfun

fun json_internal_to_string js
    let output ""
    for let i js[1]; i < js[2]; i++
        let output output + js[0][i]
    endfor
    return output
endfun

fun json_internal_json_to_string j depth
    let indent ""
    for let i 0; i < depth; i++
        let indent indent + "  "
    endfor
    if j is str
        if j = "null"
            return "null"
        endif
        return "\"" + j + "\""
    elif j is float || j is int || j is bool
        return "" + j
    elif j is arr
        let output "[\n"
        for let i 0; i < len j - 1; i++
            let output output + indent + json_internal_json_to_string j[i] (depth + 1)
            let output output + ", \n"
        endfor
        if len j > 0
            let output output + indent + json_internal_json_to_string j[len j - 1] (depth + 1)
        endif
        return output + "\n" + indent + "]"
    elif j is dict
        let output "{\n"
        let k keys j
        for let i 0; i < len k - 1; i++
            let key k[i]
            let output output + indent + "\"" + key + "\": " + json_internal_json_to_string j[key] (depth + 1)
            let output output + ", \n"
        endfor
        if len j > 0
            let key k[len j - 1]
            let output output + indent + "\"" + key + "\": " + json_internal_json_to_string j[key] (depth + 1)
        endif
        return output + "\n" + indent + "}"
    endif
endfun

# Trim whitespace etc.
fun json_internal_clean_string input
    let output ""
    let quote false
    for let i 0; i < len input; i++
        if input[i] = '\"'
            let quote (!quote)
        elif (!quote) && (input[i] = ' ' || input[i] = '\t' || input[i] = '\n')
            continue
        endif
        let output output + input[i]
    endfor
    return output
endfun

fun json_internal_parse js
    if js[1] = js[2]
        return ""
    elif js[0][js[1]] = '\"'
        js[1]++; js[2]--
        return json_internal_to_string js
    elif '0' <= js[0][js[1]] && js[0][js[1]] <= '9'
        return tonum json_internal_to_string js
    elif js[0][js[1]] = '{'
        js[1]++; js[2]--
        return json_internal_parse_object js
    elif js[0][js[1]] = '['
        js[1]++; js[2]--
        return json_internal_parse_array js
    endif
    let input json_internal_to_string js
    if input = "null"
        return "null"
    elif input = "true"
        return true
    elif input = "false"
        return false
    endif
    throw "json_internal_parse: could not determine type!"
endfun

fun json_internal_find_comma js
    let braces 0
    let brackets 0
    let root true
    for let i js[1]; i < js[2]; i++
        if js[0][i] = '\"'
            let root !root
            continue
        elif js[0][i] = '\\'
            i++; continue
        endif
        if root
            if js[0][i] = ',' && braces = 0 && brackets = 0
                break
            elif js[0][i] = '['
                brackets++
            elif js[0][i] = ']'
                brackets--
            elif js[0][i] = '{'
                braces++
            elif js[0][i] = '}'
                braces--
            endif
        endif
    endfor
    return i
endfun

fun json_internal_find_colon js
    let root true
    for let i js[1]; i < js[2]; i++
        if root && js[0][i] = ':'
            break
        elif js[0][i] = '\"'
            let root !root
        endif
    endfor
    return i
endfun

fun json_internal_parse_array js
    if js[1] = js[2]
        return arr 0
    endif
    let output dict 10
    let i 0
    while true
        let split     json_internal_find_comma js
        let elem      json_internal_clone_string js js[1] split
        let output[i] json_internal_parse elem
        let js[1]     split + 1
        if split = js[2]
            let array arr len output
            for let i 0; i < len output; i++
                let array[i] output[i]
            endfor
            return array
        endif
        i++
    endwhile
endfun

fun json_internal_parse_object js
    if js[1] = js[2]
        return dict 0
    endif
    let output dict 10
    while true
        let split json_internal_find_comma js
        let obj   json_internal_clone_string js js[1] split
        let colon json_internal_find_colon obj
        let key   json_internal_clone_string obj obj[1] colon
        let key   json_internal_parse key
        assert (key is str) "json_internal_parse_object: key not a string!"
        let obj[1]      colon + 1
        let obj         json_internal_parse obj
        let output[key] obj
        let js[1] split + 1
        if split = js[2]
            return output
        endif
    endwhile
endfun

fun json_decode input
    assert (input is str) "json_decode: input not string!"
    let input json_internal_clean_string input
    let input json_internal_create_string input
    return json_internal_parse input
endfun

fun json_encode json
    return json_internal_json_to_string json 0
endfun

endif