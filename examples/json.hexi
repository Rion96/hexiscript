if (catch JSON_HEXI)
define JSON_HEXI true

fun assert cond msg
    if ! cond; throw "AssertError: " + msg; endif
endfun

fun tuple left right
    let t    arr 2
    let t[0] left
    let t[1] right
    return t
endfun

fun is_tuple t
    return (t is arr && len t = 2)
endfun

fun print_tuple t
    assert (is_tuple t) "print_tuple: not a tuple!"
    println "(" + t[0] + ";" + t[1] + ")"
endfun

fun json_internal_to_string j depth
    let indent ""
    for let i 0; i < depth; i++
        let indent indent + "  "
    endfor
    if j is str
        if j = "null"
            return "null"
        endif
        return "\"" + j + "\""
    elif j is float || j is int || j is bool
        return "" + j
    elif j is arr
        let output "[\n"
        for let i 0; i < len j - 1; i++
            let output output + indent + json_internal_to_string j[i] (depth + 1)
            let output output + ", \n"
        endfor
        if len j > 0
            let output output + indent + json_internal_to_string j[len j - 1] (depth + 1)
        endif
        return output + "\n" + indent + "]"
    elif j is dict
        let output "{\n"
        let k keys j
        for let i 0; i < len k - 1; i++
            let key k[i]
            let output output + indent + "\"" + key + "\": " + json_internal_to_string j[key] (depth + 1)
            let output output + ", \n"
        endfor
        if len j > 0
            let key k[len j - 1]
            let output output + indent + "\"" + key + "\": " + json_internal_to_string j[key] (depth + 1)
        endif
        return output + "\n" + indent + "}"
    endif
endfun

fun split_string input pos
    assert (pos > 0 && pos < len input) "split_string input exceeds bounds!"
    let left ""
    let right ""
    for let i 0; i < len input; i++
        if (i < pos)
            let left left + input[i]
        elif (i > pos)
            let right right + input[i]
        endif
    endfor
    return tuple left right
endfun

# Trim string on both sides
fun json_internal_trim_string input
    assert (input is str) "json_internal_trim_string: input not string!"
    assert (len input > 1) "json_internal_trim_string: input too small!"
    let output ""
    for let i 1; i < len input - 1; i++
        let output output + input[i]
    endfor
    return output
endfun

# Trim whitespace etc.
fun json_internal_clean_string input
    assert (input is str) "json_internal_clean_string: input not string!"
    let output ""
    let quote false
    for let i 0; i < len input; i++
        if input[i] = '\"'
            let quote (!quote)
        elif (!quote) && (input[i] = ' ' || input[i] = '\t' || input[i] = '\n')
            continue
        endif
        let output output + input[i]
    endfor
    return output
endfun

# JSON parsing
fun json_internal_parse input
    assert (input is str) "json_internal_parse: input not string!"
    if (len input = 0)
        return ""
    endif
    # Case 1: input is null
    if (input = "null")
        return "null"
    endif
    # Case 2: input is string
    if (input[0] = '\"')
        assert (input[len input - 1] = '\"') "json_internal_parse: string not closed with \'\"\'"
        let input json_internal_trim_string input
        return input
    endif
    # Case 3: input is number
    if ('0' <= input[0] && input[0] <= '9')
        let i len input - 1
        assert ('0' <= input[i] && input[i] <= '9') "json_internal_parse: number not a number"
        let n tonum input
        assert ( !(catch n) ) ("json_internal_parse: " + input + " is not a number!")
        return n
    endif
    if input = "true"
        return true
    endif
    if input = "false"
        return false
    endif
    # Case 4: input is object
    if (input[0] = '{')
        assert (input[len input - 1] = '}') "json_internal_parse: object not closed with \''}\'"
        let input json_internal_trim_string input
        let obj json_internal_parse_object input
        return obj
    endif
    # Case 5: input is array
    if (input[0] = '[')
        assert (input[len input - 1] = ']') "json_internal_parse: array not closed with \']\'"
        let input json_internal_trim_string input
        let array json_internal_parse_array input
        return array
    endif
    throw ("json_internal_parse: could not determine type at: " + input)
endfun

fun json_internal_find_comma input 
    assert (input is str) "json_internal_find_comma: input not string!"
    let braces 0
    let brackets 0
    let quote false
    for let i 0; i < len input; i++
        assert (braces >= 0) "json_internal_find_comma: braces below 0!"
        assert (brackets >= 0) "json_internal_find_comma: brackets below 0!"
        if input[i] = ','
            if braces = 0 && brackets = 0 && !quote
                return i
            endif
        elif input[i] = '\\'
            i++
            continue
        elif input[i] = '['
            let brackets brackets + 1
        elif input[i] = ']'
            let brackets brackets - 1
        elif input[i] = '{'
            let braces braces + 1
        elif input[i] = '}'
            let braces braces - 1
        elif input[i] = '\"'
            let quote (!quote)
        endif
    endfor
    assert (brackets = 0) "json_internal_find_comma: found stray brackets!"
    assert (braces = 0) "json_internal_find_comma: found stray braces!"
    assert (! quote) "json_internal_find_comma: found stray quotes!"
    # No comma found!
    return len input
endfun

fun json_internal_find_colon input
    assert (input is str) "json_internal_find_colon: input not string!"
    assert (len input > 0) "json_internal_find_colon: input is empty!"
    let quote false
    for let i 0; i < len input; i++
        if (!quote) && input[i] = ':'
            return i
        elif input[i] = '\"'
            let quote (!quote)
        endif
    endfor
    assert (! quote) "json_internal_find_colon: found stray quotes!"
    return len input
endfun

fun json_internal_split_colon input
    let pos json_internal_find_colon input
    assert (pos < len input) "json_internal_split_colon: no colon found!"
    return split_string input pos
endfun

fun json_internal_split_comma input
    let pos json_internal_find_comma input
    if pos < len input
        return split_string input pos
    endif
    # No comma found!
    return tuple input ""
endfun

fun json_internal_parse_array input
    # Empty array
    if len input = 0
        return arr 0
    endif
    let output dict 10
    let i 0
    while true
        let t json_internal_split_comma input
        let output[i] json_internal_parse t[0]
        if len t[1] = 0
            let array arr len output
            for let i 0; i < len output; i++
                let array[i] output[i]
            endfor
            return array
        else
            let input t[1]
        endif
        i++
    endwhile
endfun

fun json_internal_parse_object input
    if len input = 0
        return dict 0
    endif
    let output dict 10
    # Empty dictionary
    while true
        let t   json_internal_split_comma input
        let kv  json_internal_split_colon t[0]
        let key json_internal_parse kv[0]
        assert (key is str) "json_internal_parse_object: key not a string!"
        let value json_internal_parse kv[1]
        let output[key] value
        if len t[1] = 0
            return output
        else
            let input t[1]
        endif
    endwhile
endfun

fun json_decode input
    assert (input is str) "json_decode: input not string!"
    let input json_internal_clean_string input
    return json_internal_parse input
endfun

# Alias
fun json_encode json
    return json_internal_to_string json 0
endfun

fun main
    let string "\"robin\""
    let string "123"
    let string "[\"Test\", 2, [\"a\",\"b b\",\"c\"], 3, [], \"Howdy\"]"
    let string "{\"key\":\"value\"}"
    let string "{\"name\":   \"robin\", \"test\": \"yup\", \"list\": [1,2,[],3]}"
    let json json_decode string
    let output json_encode json
    println output

    let file openin "test.json"
    let string ""
    while !(catch (let c read char file))
        let string string + c
    endwhile
    println string
    let json json_decode string
    println json_encode json
endfun
main()

endif
